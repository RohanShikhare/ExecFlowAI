# Database
DB_URL=jdbc:postgresql://localhost:5432/execflow
DB_USERNAME=execflow
DB_PASSWORD=execflow

# JWT
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRATION_MS=86400000

# Invite-only registration. Anyone registering must supply this exact
# code. Pick a long random string, keep it private, and only share it
# with people you personally approve.
REGISTRATION_SECRET=replace-with-a-long-random-invite-code

# AI provider (Groq - free tier, get a key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Local file storage
STORAGE_BASE_PATH=./uploads

# Local Whisper transcription microservice
WHISPER_SERVICE_URL=http://localhost:9000

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
